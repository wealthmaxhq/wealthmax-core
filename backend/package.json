{
  "name": "wealth-planner-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "npm run test:verify-tiers && jest --runInBand",
    "test:verify-tiers": "node scripts/verify-test-tiers.js",
    "test:fast": "node scripts/run-test-tier.js fast",
    "test:dart-bridge": "node scripts/run-test-tier.js dartBridge"
  },
  "dependencies": {
    "express": "^5.2.1",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "better-sqlite3": "^13.0.1",
    "express-rate-limit": "^8.6.2"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^24.10.0",
    "@types/bcrypt": "^6.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "supertest": "^7.2.2",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3"
  }
}
